# AptMaintain Backend Environment Variables
PORT=5000

# ==============================================================================
# DATABASE CONFIGURATION (CHOOSE ONE OPTION):
# ==============================================================================
# OPTION 1: Zero-Storage Local Mode (DEFAULT - 0 MB DISK SPACE NEEDED)
# If MongoDB is not installed on your laptop, leave the default below.
# The server automatically activates an in-memory store so you can test
# tickets and registration immediately without installing anything!
MONGO_URI=mongodb://127.0.0.1:27017/aptmaintain

# OPTION 2: Free Cloud MongoDB Atlas (RECOMMENDED - 0 MB DISK SPACE NEEDED)
# Create a free cloud cluster at https://www.mongodb.com/cloud/atlas
# and paste your cloud connection string below:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aptmaintain?retryWrites=true&w=majority

# ==============================================================================
# CLIENT URL CONFIGURATION (FOR CORS):
# ==============================================================================
CLIENT_ORIGIN=http://localhost:5173